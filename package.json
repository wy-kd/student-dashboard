{
  "name": "student-dashboard",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup.mjs --install",
    "predev": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "prestart": "node scripts/setup.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "password:reset": "node --import tsx scripts/reset-password.ts",
    "push:setup": "node scripts/push-setup.mjs",
    "postbuild": "node --import tsx --test tests/production-css.integration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "lucide-react": "0.468.0",
    "next": "16.3.4",
    "prisma": "6.19.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.20.6",
    "web-push": "3.6.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/web-push": "3.6.4",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3"
  },
  "type": "module"
}
